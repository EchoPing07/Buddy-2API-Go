# Buddy 2API Go 环境变量示例（env > config.json > 内置默认）
# 完整说明见 docs/DEVELOPMENT.md §12

# 监听地址（默认 127.0.0.1:10082；Docker 里用 0.0.0.0:10082）
BUDDY2API_LISTEN=127.0.0.1:10082

# 上游端点：cn（默认，copilot.tencent.com） / global（www.codebuddy.ai）
# 两套端点凭证不互通，切换 region 需在管理后台重新扫码登录
BUDDY2API_REGION=cn

# 管理后台密码（明文，启动时 bcrypt 哈希后写回 config.json，优先级最高）
# 不设置且 config.json 无哈希时，首次启动使用默认密码 password
#BUDDY2API_ADMIN_PASSWORD=password

# 数据目录（默认 ./data）
#BUDDY2API_DATA_DIR=data

# 自动签到（默认 false）；签到方式二选一（默认 fixed）：
#   fixed  —— 按 cron 定时（6 段含秒，默认 0 0 9 * * *）
#   random —— 每天 [最早, 最晚] 内随机一个时刻执行（最晚 23:30）
# 任何一次失败 5 分钟后重试一次；末班兜底开启时（默认 true）当天没签成：
# 23:50 尝试，若失败 23:55 重试，再失败当天放弃
#BUDDY2API_AUTO_CHECKIN=true
#BUDDY2API_CHECKIN_MODE=random
#BUDDY2API_CHECKIN_CRON=0 0 9 * * *
#BUDDY2API_CHECKIN_RANDOM_START=09:00
#BUDDY2API_CHECKIN_RANDOM_END=18:00
#BUDDY2API_CHECKIN_FALLBACK=true

# 成长任务（活跃地图连登 / 连登奖励兑换与抽奖 / 补签卡 / 猫猫旅行；仅国内版账号，默认 false）：
#   上报链：每天指定时刻执行 活跃上报→连登自检→领养→礼包→补签→兑换→抽奖→旅行巡检 一整链
#   旅行巡检：猫猫旅行单动作状态机（到站领奖 / 空闲派出），9,21 表示每天 9:00 与 21:00 各一次
#   上报条数：每日对话活跃上报条数 1-10（缺省 10；领养前置 chat_5 需 5），同会话多轮，每条间隔 1.5 秒防风控
#   波动数：每次执行在 条数±N 内随机取一个整数（0=固定不波动，上限 10），更像真人以降低风控判定
# 错过当日上报时点时，下次启动 30 秒后自动补跑一次（当日 22:00 前有效）
# 注意：cron 时点为进程本地时区；Docker 部署若容器 TZ 非 CST（北京时间），时点需自行换算
#BUDDY2API_AUTO_GROWTH=true
#BUDDY2API_GROWTH_REPORT_CRON=0 0 10 * * *
#BUDDY2API_GROWTH_TRAVEL_CRON=0 0 9,21 * * *
#BUDDY2API_GROWTH_REPORT_COUNT=10
#BUDDY2API_GROWTH_REPORT_JITTER=0
# 任务队列：每日扫描「未完成且可自动化」的成长任务待办，逐个执行动作并自动领奖
#   （Sequential 族每日零点解锁一环，故默认放在凌晨 1 点）
# 夜猫子：black_cat 只在 23:00–08:00 窗口内计数，窗口外自动跳过
#BUDDY2API_GROWTH_QUEUE_CRON=0 0 1 * * *
#BUDDY2API_BLACKCAT_CRON=0 0 23 * * *
# 周期补领清扫（默认开启，15 分钟一次）：只 accept / claim 已达标未领的奖励，
#   不跑任何行为链；关掉它，「有动作白名单之外的任务」达标后永远没人领奖
#BUDDY2API_TASK_SWEEP_ENABLED=true
#BUDDY2API_TASK_SWEEP_MINUTES=15

# 余额缓存秒数（默认 300）、日志保留天数（默认 90）与日志表容量上限（默认 50 MB）
#BUDDY2API_RESOURCE_CACHE_SECONDS=300
#BUDDY2API_LOG_RETENTION_DAYS=90
#BUDDY2API_LOG_MAX_SIZE_MB=50

# chat 上游响应头超时秒数（默认 60，1-3600）：上游自请求发出至开始响应的等待上限，
# 超时即中止本次请求；流式连接建立后（含推理阶段）不再受超时约束；
# 也可在管理后台「设置 → 基本」修改，改后需重启生效
#BUDDY2API_CHAT_TIMEOUT_SECONDS=60

# ── 指纹头伪装参数（可选，同 tests 程序，一般无需修改）──
#CB_GATEWAY_USER_AGENT=CLI/2.109.2 CodeBuddy/2.109.2
#CB_GATEWAY_STAINLESS_OS=Windows

# 嵌入模型实验特性（默认关闭）：开启后暴露 POST /v1/embeddings（bge-m3，1024 维）
# 也可在管理后台「实验」页切换（与 env 同源，env 优先）
#BUDDY2API_EMBEDDINGS_ENABLED=false

# 号池负载均衡实验特性（默认关闭）：
#   开启后 /v1/chat/completions 分发到 data/accounts/ 下全部账号，同一会话在 TTL 内粘同一账号；
#   签到 / 成长任务 / 夜猫子 / 任务队列 / 余额面板仍然只走当前活动账号（token.json），不参与池化。
#   关闭时零行为变化（不读写池状态表、不解析会话键、不扫账号档案）。
#   - 会话粘性 TTL（分钟，滑动续期）：默认 180 = 3 小时
#   - 网关内换号重试上限：默认 2。这是与客户端重试相乘的值——实测 pi 对 429 会重试 3 次，
#     网关取 2 → 一次失败最多 12 次上游调用。只对 429/402/401 重试，5xx 与网络中断不重试
#     （上游可能已计费）
#   - 模型冷却截断上限（分钟）：默认 360。上游 6004 会给出重置墙钟，超过此值按此值截断，
#     避免一个异常文案把模型永久封死
#   - 探测 cron（6 段含秒）：默认每天 0/6/12/18 点各探一次，走 billing 接口同时回答
#     「凭证可用吗」和「还有额度吗」，成功即自动恢复被禁用的账号
#   注意：envInt 只接受 >0，想临时关掉网关重试请用管理后台（UI 可设 0）
#BUDDY2API_POOL_ENABLED=false
#BUDDY2API_POOL_SESSION_TTL=180
#BUDDY2API_POOL_MAX_RETRY=2
#BUDDY2API_POOL_COOL_MAX_MIN=360
#BUDDY2API_POOL_PROBE_CRON=0 0 0,6,12,18 * * *

