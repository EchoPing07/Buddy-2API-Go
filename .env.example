# Buddy2API 环境变量示例（env > config.json > 内置默认）
# 完整说明见 docs/DEVELOPMENT.md §12

# 监听地址（默认 127.0.0.1:10082；Docker 里用 0.0.0.0:10082）
BUDDY2API_LISTEN=127.0.0.1:10082

# 上游端点：cn（默认，copilot.tencent.com） / global（www.codebuddy.ai）
# 两套端点凭证不互通，切换 region 需在管理后台重新扫码登录
BUDDY2API_REGION=cn

# 管理后台密码（明文，启动时 bcrypt 哈希后写回 config.json，优先级最高）
# 不设置且 config.json 无哈希时，首次启动会随机生成并打印到 stdout 一次
#BUDDY2API_ADMIN_PASSWORD=

# 数据目录（默认 ./data）
#BUDDY2API_DATA_DIR=data

# 自动签到（默认 false），cron 为 6 段含秒表达式
#BUDDY2API_AUTO_CHECKIN=true
#BUDDY2API_CHECKIN_CRON=0 0 9 * * *

# 余额缓存秒数（默认 300）与日志保留天数（默认 90）
#BUDDY2API_RESOURCE_CACHE_SECONDS=300
#BUDDY2API_LOG_RETENTION_DAYS=90

# ── 指纹头伪装参数（可选，同 tests 程序，一般无需修改）──
#CB_GATEWAY_USER_AGENT=CLI/2.109.2 CodeBuddy/2.109.2
#CB_GATEWAY_STAINLESS_OS=Windows
